model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - silver_lakehouse"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table calendar
ref table category
ref table products
ref table sales
ref table sales_predictions
ref table territories

